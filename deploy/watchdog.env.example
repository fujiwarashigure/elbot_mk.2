# ElBot external watchdog settings. Copy to watchdog.env and edit.
# The watchdog only checks the independent /live endpoint and restarts the
# single ElBot container with cooldown and restart limits.

# WATCHDOG_HEALTH_URL=http://127.0.0.1:32171/live
# WATCHDOG_READY_URL=http://127.0.0.1:32171/ready
# WATCHDOG_HEALTHZ_URL=http://127.0.0.1:32171/healthz

# Consecutive /live failures before a restart is considered.
WATCHDOG_FAILURE_THRESHOLD=3
# Minimum seconds between automatic restarts.
WATCHDOG_COOLDOWN_SECONDS=300
# Maximum automatic restarts inside WATCHDOG_WINDOW_SECONDS.
WATCHDOG_MAX_RESTARTS=3
# Rolling window for restart limits.
WATCHDOG_WINDOW_SECONDS=21600
# Diagnostics directory and state directory (defaults are under deploy/).
# WATCHDOG_DIAG_DIR=/opt/elbot/deploy/diagnostics
# WATCHDOG_STATE_DIR=/opt/elbot/deploy/watchdog-state
# Optional webhook for restart/paused notifications.
# WATCHDOG_WEBHOOK_URL=https://example.invalid/elbot-alert
# Set to 1 to only log/diagnose without restarting.
# WATCHDOG_DRY_RUN=0
