# ============================================================
# ElBot 部署环境变量
# 复制为 .env 后填写；.env 会被 docker compose 注入容器，同时也是
# ElBot 读取的进程环境变量（优先级高于配置目录下的 .env）。
# 权限建议：chmod 600 .env
#
# 注意：Compose env_file 注入的是 ElBot 进程环境，Shell / Hook 子进程
# 也可能继承这里的全部变量。面向群聊用户开放工具时，不要只依赖
# “容器不是 root”来保护 API Key；详见部署 README 第 11 节。
# ============================================================

# ---------- Compose 项目名（保持与 systemd 单元一致）----------
COMPOSE_PROJECT_NAME=elbot

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- 独立运维健康接口 ----------
# 仅在容器内部 / 宿主机回环地址可访问：
#   /live   始终公开：进程是否仍在运行（不判断心跳/平台/模型）
#   /ready  始终公开：进程初始化、数据目录可写、调度心跳未过期；平台/模型故障不影响
#   /healthz 汇总状态；未设置 ELBOT_OPS_TOKEN 且未显式允许无鉴权时不注册。
#            平台/模型故障为 degraded，调度心跳过期 /ready 为 not_ready
# Compose 已把 32171 只映射到宿主机 127.0.0.1；原生部署可改成 127.0.0.1:32171。
ELBOT_HEALTH_ADDR=0.0.0.0:32171
ELBOT_HEALTH_LIVE_STALE_SECONDS=90
# /tasks、/metrics、/diagnostics、/plugins/* 和 /healthz 的访问 token。
# 未设置时敏感运维接口默认不注册，只保留 /live 和 /ready；
# watchdog 用 WATCHDOG_OPS_TOKEN 填同一个值。
# ELBOT_OPS_TOKEN=请替换为随机长字符串
# 仅排障用：显式允许无鉴权暴露敏感运维接口（必须只用于回环/可信网络）。
# ELBOT_OPS_ALLOW_UNAUTHENTICATED=1
# watchdog 重启原因文件；默认按 XDG_RUNTIME_DIR 读取 /data/run/elbot/last_restart_reason
# ELBOT_RESTART_REASON_FILE=/data/run/elbot/last_restart_reason

# ---------- 镜像 / 构建参数（docker compose 变量） ----------
# ELBOT_VERSION 应与 deploy/VERSION 保持一致（deploy/VERSION 是默认版本号的单点来源；
# build-push.sh / prepare-offline.sh 在未显式指定时会读取它）
ELBOT_IMAGE=elbot:0.6.6
ELBOT_VERSION=0.6.6
GO_VERSION=1.26
# runtime（精简，默认）或 go-runtime（带 Go 工具链，可编译 Go Skill）
ELBOT_BUILD_TARGET=runtime
# 可选：基础镜像覆盖（国内加速 / pin digest）
# GO_BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/library/golang
# RUNTIME_BASE_IMAGE=debian:bookworm-slim@sha256:<digest>
# 可选：给运行镜像追加更多系统命令；默认命令列表在 deploy/Dockerfile 内，只增不减
# EXTRA_TOOLS=imagemagick ffmpeg
# Go 模块代理：国内直连 proxy.golang.org 会超时，构建（含容器内编译 Go Skill）会失败。
# 国内服务器/本机请保持这一行；能直连时改成 https://proxy.golang.org,direct
GOPROXY=https://goproxy.cn,direct
# apt 镜像主机名：国内构建必设，否则 apt 走 deb.debian.org（实测只有十几 KB/s，像卡死）：
#   阿里云 VPS -> mirrors.aliyun.com；腾讯云 VPS -> mirrors.cloud.tencent.com
#   通用可用 -> mirrors.ustc.edu.cn / mirrors.tuna.tsinghua.edu.cn
APT_MIRROR=mirrors.ustc.edu.cn

# ---------- LLM Provider 密钥 ----------
# services.toml（旧部署 providers.toml）中 api_key_env 指向的名字必须与此处一致
DEEPSEEK_API_KEY=sk-请替换
OPENAI_API_KEY=sk-请替换
# 可选：生图服务 API Key（services.toml 的 [image_generation].api_key_env 默认读这个）
# 建议使用与 LLM 分开的 Key，并在中转站设置额度/限速；不要给群聊用户无限生图额度。
IMAGE_API_KEY=sk-请替换

# ---------- CLI 远程 WebSocket 服务端 token ----------
# 对应 app.toml 的 [platform.cli.server.tokens]
# 客户端 client_id 使用 local 时即为超级管理员（security.superadmins.cli=["local"]）
ELBOT_CLI_LOCAL_TOKEN=请替换为随机长字符串
# ELBOT_CLI_WINDOWS_TOKEN=请替换为随机长字符串

# ---------- Elnis 事件入口 token ----------
# 对应 elnis.toml 的 [tokens.home]
ELNIS_HOME_TOKEN=请替换为随机长字符串

# ---------- 平台密钥（按需启用） ----------
# QQ 官方机器人
# QQOFFICIAL_CLIENT_SECRET=请替换
# QQ OneBot
# QQONEBOT_ACCESS_TOKEN=请替换
# Telegram
# TELEGRAM_BOT_TOKEN=请替换
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080

# ---------- 媒体对象存储（可选） ----------
# app.toml [file_delivery] backend = "s3" / "hybrid" 时使用
# ELBOT_S3_ACCESS_KEY_ID=请替换
# ELBOT_S3_SECRET_ACCESS_KEY=请替换

# ---------- Go Skill 编译（仅 go-runtime 或原生部署需要） ----------
# ELBOT_GO_BINARY=/usr/local/go/bin/go
