# ============================================================
# ElBot 部署环境变量
# 复制为 .env 后填写；.env 会被 docker compose 注入容器，同时也是
# ElBot 读取的进程环境变量（优先级高于配置目录下的 .env）。
# 权限建议：chmod 600 .env
#
# 注意：Compose env_file 注入的是 ElBot 进程环境，Shell / Hook 子进程
# 也可能继承这里的全部变量。面向群聊用户开放工具时，不要只依赖
# “容器不是 root”来保护 API Key；详见部署 README 第 11 节。
# ============================================================

# ---------- Compose 项目名（保持与 systemd 单元一致）----------
COMPOSE_PROJECT_NAME=elbot

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- 独立运维健康接口 ----------
# 仅在容器内部 / 宿主机回环地址可访问：
#   /live   关键调度循环是否仍在推进
#   /ready  SQLite 目录可写、必要组件、平台连接是否就绪
#   /healthz 汇总状态；模型 API 故障显示为 degraded，不触发自动重启
# Compose 已把 32171 只映射到宿主机 127.0.0.1；原生部署可改成 127.0.0.1:32171。
ELBOT_HEALTH_ADDR=0.0.0.0:32171
ELBOT_HEALTH_LIVE_STALE_SECONDS=90

# ---------- 镜像 / 构建参数（docker compose 变量） ----------
ELBOT_IMAGE=elbot:0.5.0
ELBOT_VERSION=0.5.0
GO_VERSION=1.26
# runtime（精简，默认）或 go-runtime（带 Go 工具链，可编译 Go Skill）
ELBOT_BUILD_TARGET=runtime

# ---------- LLM Provider 密钥 ----------
# providers.toml 中 api_key_env 指向的名字必须与此处一致
DEEPSEEK_API_KEY=sk-请替换
OPENAI_API_KEY=sk-请替换
# 可选：生图服务 API Key（app.toml [image_generation].api_key_env 默认读这个）
# 建议使用与 LLM 分开的 Key，并在中转站设置额度/限速；不要给群聊用户无限生图额度。
IMAGE_API_KEY=sk-请替换

# ---------- CLI 远程 WebSocket 服务端 token ----------
# 对应 app.toml 的 [platform.cli.server.tokens]
# 客户端 client_id 使用 local 时即为超级管理员（security.superadmins.cli=["local"]）
ELBOT_CLI_LOCAL_TOKEN=请替换为随机长字符串
# ELBOT_CLI_WINDOWS_TOKEN=请替换为随机长字符串

# ---------- Elnis 事件入口 token ----------
# 对应 elnis.toml 的 [tokens.home]
ELNIS_HOME_TOKEN=请替换为随机长字符串

# ---------- 平台密钥（按需启用） ----------
# QQ 官方机器人
# QQOFFICIAL_CLIENT_SECRET=请替换
# QQ OneBot
# QQONEBOT_ACCESS_TOKEN=请替换
# Telegram
# TELEGRAM_BOT_TOKEN=请替换
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080

# ---------- 媒体对象存储（可选） ----------
# app.toml [file_delivery] backend = "s3" / "hybrid" 时使用
# ELBOT_S3_ACCESS_KEY_ID=请替换
# ELBOT_S3_SECRET_ACCESS_KEY=请替换

# ---------- Go Skill 编译（仅 go-runtime 或原生部署需要） ----------
# ELBOT_GO_BINARY=/usr/local/go/bin/go
