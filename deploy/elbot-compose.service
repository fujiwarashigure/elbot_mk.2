[Unit]
Description=ElBot container stack (docker compose)
Documentation=https://github.com/Elflare/elbot
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/elbot/deploy
Environment=COMPOSE_PROJECT_NAME=elbot
# 如 docker 不在 /usr/bin/docker，请改成 `command -v docker` 的结果
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecReload=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
